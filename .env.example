# Copy to .env and fill in. Never commit .env.
# Every variable is documented in README.md (Configuration).
#
# This file holds settings only. Secrets (the wallet secret, the admin token, supplier keys) go in the
# secrets source, never here: startup refuses a secret set in the environment. See secrets.example.json
# and README.md (Secrets and sealed state).

# development (default) or sealed. Sealed mode refuses a database that is not on a mount listed below.
# BELLOWS_MODE=development
# BELLOWS_SECRETS=file                            # file | platform (default: file in development, platform in sealed)
# BELLOWS_SECRETS_FILE=data/secrets.json          # default: secrets.json next to the database
# BELLOWS_SEALED_MOUNTS=/data                     # mount points of the encrypted volume

# Attested identity at /.well-known/bellows (docs/ATTESTATION.md).
# BELLOWS_ATTESTER=dev                            # dev | tinfoil (default: dev in development, tinfoil in sealed)
# BELLOWS_TINFOIL_ATTESTATION_SOCKET=/tinfoil/attestation.sock
# BELLOWS_ATTEST_REFRESH_MINUTES=360
# BELLOWS_BUILD_MEASUREMENT={"type":"...","registers":["..."]}   # the claim, from builds.json
# BELLOWS_RELAYS=https://relay.example/relay/bellows.example   # Oblivious HTTP relay URLs (comma separated)
# BELLOWS_OPERATOR_ANNOUNCEMENT_FILE=/data/announcement.json
# BELLOWS_OPERATOR_ANNOUNCEMENT={...}            # or the signed event itself, as JSON (a sealed deployment gets it from the keyserver)

# Oblivious HTTP gateway at POST /ohttp (docs/OHTTP.md).
# BELLOWS_OHTTP_MAX_SKEW_SECONDS=300
# BELLOWS_OHTTP_REPLAY_CACHE_MAX=200000
# New encapsulated requests admitted per second, all clients together. Unset: the most the replay cache holds.
# BELLOWS_OHTTP_ADMIT_PER_SECOND=332
# Largest request, and largest plain (not chunked) answer. Chunked answers are bounded at 1 GiB.
# BELLOWS_OHTTP_MAX_MESSAGE_BYTES=8388608

# Required: the mints whose eCash this gateway accepts (comma separated).
BELLOWS_TRUSTED_MINTS=https://mint.example.com
# Other addresses of the same mint (alias=main); tokens under an alias are handled under the main address.
# BELLOWS_MINT_ALIASES=https://second.mint.example.com=https://mint.example.com
BELLOWS_UNITS=usd,sat
BELLOWS_DEFAULT_UNIT=usd
BELLOWS_MARKUP=1.25
# Name shown in NUT-18 payment requests.
# BELLOWS_SERVICE_NAME=Bellows
# Optional gate: new balances and pay-per-request calls need an invite code.
# BELLOWS_INVITE_ONLY=false

# SQLite database: balances and the state of the gateway's eCash wallet. Back it up, and keep the wallet
# secret (in the secrets source) offline as well.
# BELLOWS_DB_PATH=data/bellows.db

# BELLOWS_RATE_SOURCES=coinbase,kraken,bitstamp
# BELLOWS_RATE_MIN_SOURCES=2
# BELLOWS_RATE_LIMIT_RPM=60                       # per balance key
# BELLOWS_ANON_RATE_LIMIT_RPM=600                 # shared by all requests without a known balance key
# BELLOWS_POW_BITS=16                             # proof of work to open a new balance; 0 = off
# BELLOWS_MAX_BODY_BYTES=1000000
# BELLOWS_LOG_LEVEL=info

# Funding a balance through the funding mint (see docs/PAYMENTS.md).
# BELLOWS_FUND_MINT=https://mint.example.com      # default: first trusted mint
# BELLOWS_LIGHTNING_ENABLED=true
# BELLOWS_FUND_MAX_SAT=1000000
# BELLOWS_FUND_MAX_USD=50000                       # cents
# BELLOWS_MINT_QUOTE_CHECKS_PER_MIN=12             # all fundings share the mint's per-IP limit (Nutshell: 20/min)
# On-chain (NUT-30) is off until tested against your funding mint:
# BELLOWS_ONCHAIN_ENABLED=false
# BELLOWS_ONCHAIN_CONFIRMATIONS=3                  # shown to users; the mint decides
# BELLOWS_ESPLORA_URL=                             # optional, e.g. your own mempool instance
# eCash from other mints:
# BELLOWS_FOREIGN_ENABLED=true
# BELLOWS_FOREIGN_POLICY=discovered                # discovered | allowlist | any
# BELLOWS_FOREIGN_ALLOW=                           # operator list of accepted mints (the admin API can add more)
# BELLOWS_FOREIGN_DENY=                            # never accepted; wins over everything
# BELLOWS_FOREIGN_MIN_REVIEWERS=2                  # NIP-87 reviewers a discovered mint needs
# BELLOWS_FOREIGN_REQUIRE_ANNOUNCEMENT=false       # also require the mint's own NIP-87 announcement
# BELLOWS_FOREIGN_DISCOVERY_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net   # empty = no discovery
# BELLOWS_FOREIGN_DISCOVERY_TTL_MINUTES=60
# BELLOWS_FOREIGN_MAX_DISCOVERED=25
# BELLOWS_FOREIGN_MAX_SAT=100000
# BELLOWS_FOREIGN_MAX_USD=5000                     # cents
# BELLOWS_FOREIGN_UNLISTED=true                    # customers may use a mint that is not listed, after a warning
# BELLOWS_FOREIGN_UNLISTED_MAX_SAT=5000            # cap for an unlisted mint
# BELLOWS_FOREIGN_UNLISTED_MAX_USD=500             # cents

# Admin API (/admin/api). It answers 404 unless the secrets source holds BELLOWS_ADMIN_TOKEN (or its hash).
# BELLOWS_ADMIN_ORIGIN=https://gateway.example.com
